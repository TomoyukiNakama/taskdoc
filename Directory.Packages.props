<Project>
  <!-- Central Package Management: versions live here only; csproj files reference packages without Version. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Avalonia (keep all Avalonia.* versions in sync)">
    <!-- Stay on 12.0.x: Avalonia 12.1+ ships source generators that need Roslyn 4.14 (SDK 9.0.300+), so they do not run
         on the .NET 8 SDK. Avalonia.Browser / .iOS / .Android 12.x support net10.0 only; those heads stay on net10.0. -->
    <PackageVersion Include="Avalonia" Version="12.0.5" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.0.5" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.0.5" />
    <PackageVersion Include="Avalonia.iOS" Version="12.0.5" />
    <PackageVersion Include="Avalonia.Browser" Version="12.0.5" />
    <PackageVersion Include="Avalonia.Android" Version="12.0.5" />
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="12.0.5" />
    <PackageVersion Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
    <PackageVersion Include="Xamarin.AndroidX.Core.SplashScreen" Version="1.0.1.15" />
  </ItemGroup>

  <ItemGroup Label="Client">
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- shadcn/ui-style theme and controls for Avalonia 12 (MIT). 0.2.3 is the last version with a net8.0 target and Avalonia 12.0 support. -->
    <PackageVersion Include="ShadUI" Version="0.2.3" />
    <!-- Fluent (Windows 11 style) controls for the WPF app (MIT). -->
    <PackageVersion Include="WPF-UI" Version="4.3.0" />
    <!-- Refit 17 targets net10.0+ only; 16.x is the last line with net8.0. -->
    <PackageVersion Include="Refit" Version="16.4.0" />
    <PackageVersion Include="Refit.HttpClientFactory" Version="16.4.0" />
    <!-- Microsoft.Extensions.* 10.x also ship net8.0 assets; Refit 16 requires Microsoft.Extensions.Http >= 10 even on net8.0. -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup Label="API">
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="6.9.0" />
    <PackageVersion Include="Dapper" Version="2.1.100" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="8.0.34" />
    <PackageVersion Include="dbup-sqlite" Version="6.0.4" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.34" />
    <PackageVersion Include="System.DirectoryServices.Protocols" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <!-- xunit.v3 stays on 3.2.x: Avalonia.Headless.XUnit 12.x is built against 3.2.2 and fails test discovery on 4.x. -->
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.34" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.1" />
  </ItemGroup>
</Project>
