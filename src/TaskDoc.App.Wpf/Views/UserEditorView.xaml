<UserControl x:Class="TaskDoc.WpfApp.Views.UserEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             MinWidth="420">
    <!-- Shown in a WPF-UI ContentDialog (WpfDialogService). -->
    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </UserControl.InputBindings>

    <StackPanel>
        <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Title}" />
        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" Text="種類は登録後に変更できません。"
                   Visibility="{Binding IsNew, Converter={StaticResource BoolToVisibility}}" />

        <!-- Auth type: chosen at registration, fixed afterwards. -->
        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,12,0,6" Text="種類" />
        <StackPanel Orientation="Horizontal" IsEnabled="{Binding IsNew}">
            <RadioButton x:Name="LocalRadio" GroupName="AuthType" Content="システムユーザー" IsChecked="{Binding IsLocal}" />
            <RadioButton x:Name="AdRadio" GroupName="AuthType" Margin="20,0,0,0" Content="AD ユーザー" IsChecked="{Binding IsAd}" />
        </StackPanel>

        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,12,0,6" Text="ユーザー名" />
        <ui:TextBox x:Name="UserNameBox" Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                    IsReadOnly="{Binding IsNew, Converter={StaticResource InverseBool}}" />
        <!-- Only when registering: the user name is read-only when editing. -->
        <TextBlock Style="{StaticResource FieldHint}" Text="半角英数字と . _ -（AD ユーザーは AD のアカウント名）"
                   Visibility="{Binding IsNew, Converter={StaticResource BoolToVisibility}}" />

        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,12,0,6" Text="表示名" />
        <ui:TextBox x:Name="DisplayNameBox" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="例: 山田 太郎" />

        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,12,0,6" Text="メールアドレス（任意）" />
        <ui:TextBox x:Name="EmailBox" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />

        <StackPanel Visibility="{Binding ShowInitialPassword, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,12,0,6" Text="初期パスワード" />
            <ui:PasswordBox x:Name="PasswordBox" Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Style="{StaticResource FieldHint}" Text="8 文字以上" />
        </StackPanel>

        <!-- Side by side to keep the dialog short enough to fit without scrolling. -->
        <WrapPanel Margin="0,12,0,0">
            <CheckBox x:Name="IsAdminCheck" Margin="0,0,24,0" Content="システム管理者" IsChecked="{Binding IsAdmin}"
                      IsEnabled="{Binding CanChangeAdminAndStatus}" />
            <CheckBox x:Name="IsActiveCheck" Content="有効（ログインできる）" IsChecked="{Binding IsActive}"
                      IsEnabled="{Binding CanChangeAdminAndStatus}"
                      Visibility="{Binding IsNew, Converter={StaticResource InverseBoolToVisibility}}" />
        </WrapPanel>
        <TextBlock Style="{StaticResource FieldHint}" Text="自分自身の管理者権限と有効/無効は、ほかの管理者が変更してください。"
                   Visibility="{Binding IsEditingSelf, Converter={StaticResource BoolToVisibility}}" />

        <ui:InfoBar x:Name="ErrorBar" Margin="0,12,0,0" Severity="Error" IsClosable="False"
                    IsOpen="{Binding HasError, Mode=OneWay}" Message="{Binding ErrorMessage}" />

        <StackPanel Margin="0,16,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <ui:Button x:Name="CancelButton" Content="キャンセル" Command="{Binding CancelCommand}" />
            <ui:Button x:Name="SaveButton" Margin="8,0,0,0" Appearance="Primary" Command="{Binding SaveCommand}">
                <StackPanel Orientation="Horizontal">
                    <ui:ProgressRing Style="{StaticResource BusyRing}"
                                     Visibility="{Binding SaveCommand.IsRunning, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="保存" />
                </StackPanel>
            </ui:Button>
        </StackPanel>

        <!-- Password reset for existing system users -->
        <StackPanel Visibility="{Binding ShowPasswordReset, Converter={StaticResource BoolToVisibility}}">
            <Separator Margin="0,16,0,12" />
            <TextBlock FontWeight="SemiBold" Text="パスワードの再設定" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock Style="{StaticResource FieldHint}"
                       Text="新しいパスワードを設定すると、このユーザーはすべての端末でログアウトされ、ロックも解除されます。" />
            <DockPanel Margin="0,8,0,0">
                <ui:Button x:Name="ResetPasswordButton" DockPanel.Dock="Right" Margin="8,0,0,0" Appearance="Danger"
                           Content="再設定" Command="{Binding ResetPasswordCommand}" />
                <ui:PasswordBox x:Name="NewPasswordBox" PlaceholderText="新しいパスワード（8 文字以上）"
                                Password="{Binding NewPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>
            <ui:InfoBar x:Name="ResetBar" Margin="0,8,0,0" Severity="Success" IsClosable="False"
                        IsOpen="{Binding HasResetMessage, Mode=OneWay}" Message="{Binding ResetMessage}" />
        </StackPanel>
    </StackPanel>
</UserControl>
