<ui:FluentWindow x:Class="TaskDoc.WpfApp.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="TaskDoc"
                 Width="1100" Height="720"
                 MinWidth="640" MinHeight="500"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="TaskDoc" />

        <!-- Current page (App.xaml's DataTemplates pick the view). -->
        <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" Focusable="False" />

        <!-- Snackbar notifications and dialogs on top of every page. The dialog host must be last (top-most). -->
        <ui:SnackbarPresenter x:Name="SnackbarPresenter" Grid.Row="1" VerticalAlignment="Bottom" />
        <ui:ContentDialogHost x:Name="DialogHost" Grid.Row="0" Grid.RowSpan="2" IsDisableSiblingsEnabled="True" />
    </Grid>
</ui:FluentWindow>
