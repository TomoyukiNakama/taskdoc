<Project Sdk="Microsoft.NET.Sdk">
  <!--
    UI-framework-independent client: view models, API clients (Refit), sign-in session.
    Shared by the Avalonia app (TaskDoc.App: Desktop / Browser / Android / iOS) the WPF app (TaskDoc.App.Wpf) and the Windows Forms app (TaskDoc.App.WinForms).
    Must not reference Avalonia, WPF or Windows Forms; dialogs, notifications and the UI thread go through the interfaces in
    Services/IPlatformServices.cs, which each app implements.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Refit.HttpClientFactory" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TaskDoc.Contracts\TaskDoc.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TaskDoc.App.Tests" />
  </ItemGroup>
</Project>
