# Normalize line endings in the repository; check out with the platform's native endings by default.
* text=auto

# Shell scripts must keep LF on every OS (Git Bash / WSL fail on CRLF with "$'\r': command not found").
*.sh text eol=lf

# PowerShell scripts: CRLF is the Windows convention (PowerShell itself accepts either).
*.ps1 text eol=crlf

# Binary assets
*.ttf binary
*.png binary
*.ico binary
*.db binary
