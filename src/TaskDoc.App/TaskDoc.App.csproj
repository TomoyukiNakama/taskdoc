<Project Sdk="Microsoft.NET.Sdk">
  <!-- Avalonia UI (views, ShadUI theme) used by the Desktop, Browser, Android and iOS heads.
       View models and API access come from TaskDoc.Client, shared with the WPF app. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="ShadUI" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TaskDoc.Client\TaskDoc.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TaskDoc.App.Tests" />
  </ItemGroup>
</Project>
