<UserControl x:Class="TaskDoc.WpfApp.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <DockPanel Margin="32,24">
        <!-- Title and actions -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button x:Name="RefreshButton" Icon="{ui:SymbolIcon ArrowSync24}" Content="更新"
                           Command="{Binding LoadCommand}" ToolTip="一覧を更新" />
                <ui:Button x:Name="EditButton" Margin="8,0,0,0" Icon="{ui:SymbolIcon Edit24}" Content="編集"
                           Command="{Binding EditCommand}" />
                <ui:Button x:Name="NewUserButton" Margin="8,0,0,0" Appearance="Primary"
                           Icon="{ui:SymbolIcon PersonAdd24}" Content="ユーザーを登録"
                           Command="{Binding NewUserCommand}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="ユーザー管理" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                           Text="ログインできるユーザーを管理します。行をダブルクリックしても編集できます。" />
            </StackPanel>
        </DockPanel>

        <ui:InfoBar x:Name="ErrorBar" DockPanel.Dock="Top" Margin="0,0,0,12" Severity="Error" IsClosable="False"
                    IsOpen="{Binding HasError, Mode=OneWay}" Message="{Binding ErrorMessage}" />

        <!-- Table -->
        <DataGrid x:Name="UserList"
                  ItemsSource="{Binding Users}"
                  SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  GridLinesVisibility="None"
                  MinColumnWidth="60"
                  MouseDoubleClick="OnUserDoubleClick">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource DefaultDataGridRowStyle}">
                    <!-- Inactive users are drawn faded. -->
                    <Setter Property="Opacity" Value="{Binding RowOpacity}" />
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="ユーザー名" Width="160" Binding="{Binding UserName}" FontWeight="SemiBold" />
                <DataGridTextColumn Header="表示名" Width="*" Binding="{Binding DisplayName}" />
                <DataGridTemplateColumn Header="種類" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <!-- WPF-UI's Secondary badge keeps white text on a light fill; set a theme-aware color. -->
                            <ui:Badge Appearance="Secondary" HorizontalAlignment="Left" Content="{Binding AuthTypeLabel}"
                                      Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="権限" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ui:Badge Appearance="Primary" HorizontalAlignment="Left" Content="管理者"
                                      Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibility}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="状態" Width="70" Binding="{Binding StatusLabel}" />
                <DataGridTextColumn Header="最終ログイン" Width="150" Binding="{Binding LastLoginLabel}" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
