{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=data/taskdoc.db"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Auth": {
    "Jwt": {
      "Issuer": "TaskDoc",
      "Audience": "TaskDoc",
      "SigningKey": null,
      "AccessTokenLifetime": "00:15:00",
      "RefreshTokenLifetime": "14.00:00:00"
    },
    "Lockout": {
      "MaxFailedAttempts": 5,
      "Duration": "00:15:00"
    },
    "ActiveDirectory": {
      "Enabled": false,
      "Server": "",
      "Port": 636,
      "UseSsl": true,
      "Domain": "",
      "Timeout": "00:00:10"
    },
    "InitialAdmin": {
      "UserName": "admin"
    }
  }
}
