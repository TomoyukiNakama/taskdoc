<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
             xmlns:app="using:TaskDoc.App"
             xmlns:vm="using:TaskDoc.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="TaskDoc.App.Views.ChangePasswordView"
             x:DataType="vm:ChangePasswordViewModel">

    <UserControl.KeyBindings>
        <KeyBinding Gesture="Enter" Command="{Binding ChangeCommand}" />
    </UserControl.KeyBindings>

    <ScrollViewer>
        <StackPanel Margin="32,24" Spacing="24">
            <StackPanel Spacing="4">
                <TextBlock Classes="h2" Text="パスワード変更" />
                <TextBlock Classes="Muted" Text="変更すると、この端末以外ではログアウトされます。" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Up to 420px wide, left-aligned, shrinking on narrow screens. (Card alone would either shrink
                 to its content when left-aligned or be centered when stretched with a MaxWidth.) -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1000*" MaxWidth="420" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
            <shadui:Card Grid.Column="0">
                <StackPanel Spacing="16">
                    <TextBox x:Name="CurrentPasswordBox" Classes="PasswordReveal" Text="{Binding CurrentPassword}"
                             PasswordChar="•" shadui:ControlAssist.Label="現在のパスワード" />
                    <TextBox x:Name="NewPasswordBox" Classes="PasswordReveal" Text="{Binding NewPassword}"
                             PasswordChar="•" shadui:ControlAssist.Label="新しいパスワード" shadui:ControlAssist.Hint="8 文字以上" />
                    <TextBox x:Name="ConfirmPasswordBox" Classes="PasswordReveal" Text="{Binding ConfirmPassword}"
                             PasswordChar="•" shadui:ControlAssist.Label="新しいパスワード（確認）" />

                    <Border Classes="alert" IsVisible="{Binding HasError}">
                        <DockPanel>
                            <TextBlock Classes="icon" DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,1,8,0"
                                       Text="{x:Static app:LucideIcons.CircleAlert}" />
                            <TextBlock x:Name="ErrorText" Text="{Binding ErrorMessage}" />
                        </DockPanel>
                    </Border>

                    <Button x:Name="ChangeButton" Classes="Primary" Content="パスワードを変更" HorizontalAlignment="Right"
                            Command="{Binding ChangeCommand}"
                            shadui:ButtonAssist.ShowProgress="{Binding ChangeCommand.IsRunning}" />
                </StackPanel>
            </shadui:Card>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
