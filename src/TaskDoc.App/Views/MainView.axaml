<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
             xmlns:vm="using:TaskDoc.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="TaskDoc.App.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="{DynamicResource WindowBackgroundColor}">

    <!-- Current page (ViewLocator picks the view), with dialogs and toasts on top. -->
    <Panel>
        <ContentControl Content="{Binding CurrentPage}" />
        <shadui:DialogHost x:Name="DialogHost" Manager="{Binding DialogManager}" />
        <shadui:ToastHost Manager="{Binding ToastManager}" />
    </Panel>
</UserControl>
