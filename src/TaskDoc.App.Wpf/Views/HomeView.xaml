<UserControl x:Class="TaskDoc.WpfApp.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar: labels when expanded, icons only when collapsed. -->
        <Border x:Name="Sidebar" Grid.Column="0" Padding="8"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Width" Value="240" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                            <Setter Property="Width" Value="64" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <!-- Header -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <ui:Button x:Name="SidebarToggle" DockPanel.Dock="Left" Appearance="Transparent"
                               Padding="10,8" Icon="{ui:SymbolIcon PanelLeft24}"
                               Command="{Binding ToggleSidebarCommand}" ToolTip="サイドバーの開閉" />
                    <TextBlock Text="TaskDoc" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"
                               Margin="8,0,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisibility}}" />
                </DockPanel>

                <!-- Footer: signed-in user and sign-out -->
                <StackPanel DockPanel.Dock="Bottom">
                    <Separator Margin="0,8" />
                    <DockPanel Margin="4,0,0,4">
                        <Border DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="16"
                                Background="{DynamicResource AccentFillColorDefaultBrush}">
                            <TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontWeight="SemiBold" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="UserText" Text="{Binding DisplayName}" FontWeight="SemiBold"
                                           MaxWidth="110" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <!-- WPF-UI's Secondary badge keeps white text on a light fill; set a theme-aware color. -->
                                <ui:Badge Margin="6,0,0,0" Appearance="Secondary" Content="管理者"
                                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                          Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Muted}" FontSize="12" Text="{Binding UserName}" />
                        </StackPanel>
                    </DockPanel>
                    <Button x:Name="SignOutButton" Style="{StaticResource NavButton}"
                            Command="{Binding SignOutCommand}" ToolTip="ログアウト">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="SignOut24" FontSize="18" />
                            <TextBlock Text="ログアウト" Margin="12,0,0,0"
                                       Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Navigation -->
                <StackPanel>
                    <TextBlock Style="{StaticResource NavHeader}" Text="メニュー"
                               Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisibility}}" />
                    <Button x:Name="DashboardNav" Style="{StaticResource NavButton}" ToolTip="ホーム"
                            Command="{Binding ShowDashboardCommand}"
                            Tag="{Binding CurrentRoute, Converter={StaticResource Equals}, ConverterParameter=dashboard}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Home24" FontSize="18" />
                            <TextBlock Text="ホーム" Margin="12,0,0,0"
                                       Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Button>

                    <StackPanel Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource NavHeader}" Text="管理"
                                   Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisibility}}" />
                        <Button x:Name="UsersNav" Style="{StaticResource NavButton}" ToolTip="ユーザー管理"
                                Command="{Binding ShowUsersCommand}"
                                Tag="{Binding CurrentRoute, Converter={StaticResource Equals}, ConverterParameter=users}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="People24" FontSize="18" />
                                <TextBlock Text="ユーザー管理" Margin="12,0,0,0"
                                           Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel Visibility="{Binding CanChangePassword, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource NavHeader}" Text="アカウント"
                                   Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisibility}}" />
                        <Button x:Name="ChangePasswordNav" Style="{StaticResource NavButton}" ToolTip="パスワード変更"
                                Command="{Binding ShowChangePasswordCommand}"
                                Tag="{Binding CurrentRoute, Converter={StaticResource Equals}, ConverterParameter=password}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Password24" FontSize="18" />
                                <TextBlock Text="パスワード変更" Margin="12,0,0,0"
                                           Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <ContentControl Grid.Column="1" Content="{Binding CurrentSection}" Focusable="False" />
    </Grid>
</UserControl>
