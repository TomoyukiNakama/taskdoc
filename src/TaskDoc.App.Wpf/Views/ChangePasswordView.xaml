<UserControl x:Class="TaskDoc.WpfApp.Views.ChangePasswordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding ChangeCommand}" />
    </UserControl.InputBindings>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24">
            <TextBlock Style="{StaticResource PageTitle}" Text="パスワード変更" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,24" Text="変更すると、この端末以外ではログアウトされます。" />

            <!-- Up to 420px wide, left-aligned, shrinking on narrow windows. -->
            <ui:Card MaxWidth="420" HorizontalAlignment="Left" Padding="20">
                <StackPanel MinWidth="300">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="現在のパスワード" />
                    <ui:PasswordBox x:Name="CurrentPasswordBox"
                                    Password="{Binding CurrentPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,16,0,6" Text="新しいパスワード" />
                    <ui:PasswordBox x:Name="NewPasswordBox"
                                    Password="{Binding NewPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource FieldHint}" Text="8 文字以上" />

                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,16,0,6" Text="新しいパスワード（確認）" />
                    <ui:PasswordBox x:Name="ConfirmPasswordBox"
                                    Password="{Binding ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <ui:InfoBar x:Name="ErrorBar" Margin="0,16,0,0" Severity="Error" IsClosable="False"
                                IsOpen="{Binding HasError, Mode=OneWay}" Message="{Binding ErrorMessage}" />

                    <ui:Button x:Name="ChangeButton" Margin="0,20,0,0" HorizontalAlignment="Right" Appearance="Primary"
                               Command="{Binding ChangeCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:ProgressRing Style="{StaticResource BusyRing}"
                                             Visibility="{Binding ChangeCommand.IsRunning, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="パスワードを変更" />
                        </StackPanel>
                    </ui:Button>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
