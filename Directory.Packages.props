<Project>
  <!-- Central Package Management: versions live here only; csproj files reference packages without Version. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Avalonia (keep all Avalonia.* versions in sync)">
    <PackageVersion Include="Avalonia" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageVersion Include="Avalonia.iOS" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Browser" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Android" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="12.1.6" />
    <PackageVersion Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
    <PackageVersion Include="Xamarin.AndroidX.Core.SplashScreen" Version="1.0.1.15" />
  </ItemGroup>

  <ItemGroup Label="Client">
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- shadcn/ui-style theme and controls for Avalonia 12 (MIT). 0.2.x requires Avalonia >= 12.1.0. -->
    <PackageVersion Include="ShadUI" Version="0.2.4" />
    <PackageVersion Include="Refit" Version="17.0.0" />
    <PackageVersion Include="Refit.HttpClientFactory" Version="17.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup Label="API">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageVersion Include="Dapper" Version="2.1.100" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.15" />
    <PackageVersion Include="dbup-sqlite" Version="6.0.4" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
    <PackageVersion Include="System.DirectoryServices.Protocols" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <!-- xunit.v3 stays on 3.2.x: Avalonia.Headless.XUnit 12.1.x is built against 3.2.2 and fails test discovery on 4.x. -->
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.1" />
  </ItemGroup>
</Project>
