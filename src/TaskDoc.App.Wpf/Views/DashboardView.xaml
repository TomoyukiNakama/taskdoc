<UserControl x:Class="TaskDoc.WpfApp.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!-- Placeholder until the task and document screens exist. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24" MaxWidth="960" HorizontalAlignment="Stretch">
            <TextBlock Style="{StaticResource PageTitle}" Text="ホーム" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,24" Text="タスクとドキュメントの画面はこれから作成します。" />

            <ui:Card HorizontalAlignment="Left" MinWidth="360" Padding="20">
                <StackPanel>
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="API 接続"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,12" Text="サーバーとデータベースに接続できるか確認します。" />
                    <TextBlock x:Name="ConnectionStatusText" Text="{Binding ConnectionStatus}" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <ui:Button x:Name="CheckConnectionButton" Margin="0,12,0,0" HorizontalAlignment="Left"
                               Command="{Binding CheckConnectionCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:ProgressRing Style="{StaticResource BusyRing}"
                                             Visibility="{Binding CheckConnectionCommand.IsRunning, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="接続を確認" />
                        </StackPanel>
                    </ui:Button>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
